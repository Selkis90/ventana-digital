# ---------- LiveKit (video) ----------
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=TU_API_KEY_LIVEKIT
LIVEKIT_API_SECRET=TU_API_SECRET_LIVEKIT

# Sala única de la aplicación
DEFAULT_ROOM=sala-principal

# Duración del acceso después de verificar el código (ej. 4h, 90m)
TOKEN_TTL=4h

# Dominios extra permitidos (opcional, separados por coma)
ALLOWED_ORIGINS=

# ---------- Twilio (SMS con el código de acceso) ----------
TWILIO_ACCOUNT_SID=TU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN
# Número que te asigna Twilio para enviar SMS (formato internacional)
TWILIO_PHONE=+1XXXXXXXXXX
# Celular del anfitrión que recibe los códigos (formato internacional)
OWNER_PHONE=+57XXXXXXXXXX

# ---------- Telegram (código de acceso GRATIS) ----------
# Si estas dos están configuradas, el código llega por Telegram y Twilio no se usa.
TELEGRAM_BOT_TOKEN=TOKEN_QUE_TE_DA_BOTFATHER
TELEGRAM_CHAT_ID=TU_ID_DE_TELEGRAM
