# ============================================================
# Ventana Digital 3.0 — variables de entorno
# En Render se ponen en: tu servicio → Environment.
# En local: copia este archivo como servidor/.env
# ============================================================

# ---------- Cloudflare Realtime (video) — OBLIGATORIAS ----------
# Panel de Cloudflare → Realtime → Serverless SFU → Create
# (plan gratis: 1.000 GB al mes, sin límite de minutos)
CF_APP_ID=TU_APP_ID
CF_APP_TOKEN=TU_APP_TOKEN

# ---------- Cloudflare TURN — OPCIONALES (recomendadas) ----------
# Ayudan a conectar desde redes de empresa que bloquean videollamadas.
# Gratis cuando se usa junto con el SFU (comparte el mismo cupo de 1.000 GB).
# Panel de Cloudflare → Realtime → TURN Server → Create
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# ---------- Sala ----------
DEFAULT_ROOM=sala-principal

# Calidad del video: alta | normal | baja
#   normal ≈ 0,45 GB por hora por cada persona que mira   (recomendado)
#   alta   ≈ 0,70 GB/h       baja ≈ 0,20 GB/h
CALIDAD=normal

# Máximo de personas a la vez (protege el cupo gratis)
MAX_PARTICIPANTES=6

# Horario (opcional). Fuera de él los equipos se desconectan solos y
# vuelven a entrar a la hora de apertura. Vacío = 24 horas.
# Ejemplos: "lun-vie 07:30-17:30"   "lun-vie 07:30-17:30; sab 08:00-12:00"
HORARIO=
ZONA_HORARIA=America/Bogota

# Dominios extra permitidos (opcional, separados por coma)
ALLOWED_ORIGINS=
